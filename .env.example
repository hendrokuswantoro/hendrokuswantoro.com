# Salin ke .env lalu isi. .env tidak pernah ikut git.
#
#   cp .env.example .env
#
# Bab 15.11: tidak ada rahasia di dalam kode. Berkas ini hanya menyebut nama
# variabelnya, tidak pernah nilainya.

# --- basis data -------------------------------------------------------------
POSTGRES_USER=hendro
POSTGRES_PASSWORD=ganti_sandi_ini
POSTGRES_DB=hendrokuswantoro
POSTGRES_PORT=5433

# Dipakai skrip migrasi dan pemuat data. Cocokkan dengan tiga nilai di atas.
DSN=postgresql://hendro:ganti_sandi_ini@127.0.0.1:5433/hendrokuswantoro

# --- cache ------------------------------------------------------------------
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380/0

# --- peta -------------------------------------------------------------------
# Token publik Mapbox. Ikut terunduh ke peramban, jadi batasi lewat URL di
# console.mapbox.com, bukan dengan menyembunyikannya.
MAPBOX_TOKEN=

# --- autentikasi ------------------------------------------------------------
# Minimal 32 karakter. Buat dengan: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Tanpa ini, seluruh jalur admin menjawab 503, bukan terbuka dengan rahasia
# bawaan. Rahasia bawaan adalah rahasia yang sudah bocor.
JWT_SECRET=
AKSES_UMUR_MENIT=15
REFRESH_UMUR_HARI=14
MASUK_GAGAL_MAKS=5
MASUK_JENDELA_MENIT=15
# false hanya untuk pengembangan lokal tanpa HTTPS
COOKIE_AMAN=true

# Dokumentasi API interaktif di /docs, /redoc, dan /openapi.json. Tertutup
# kecuali diisi "1". Ia memberi peta lengkap permukaan API kepada siapa pun
# yang membukanya; berguna saat mengembangkan, tidak ada gunanya di produksi.
DOKUMEN_API=

# --- passkey, WebAuthn -------------------------------------------------------
# rp_id adalah nama host saja: tanpa skema, tanpa porta, tanpa garis miring.
# Ia tidak boleh ditebak dari header Host, sebab header itu datang dari
# peramban dan penyerang bisa memilihnya sendiri. Kosongkan untuk mematikan
# jalur passkey; ia akan menjawab 503, bukan terbuka dengan nilai bawaan.
#
# Lokal    : WEBAUTHN_RP_ID=localhost
# Produksi : WEBAUTHN_RP_ID=hendrokuswantoro.com
#
# JANGAN memakai alamat IP, dan jangan pula memasukkannya ke WEBAUTHN_ASAL.
# WebAuthn menuntut rp_id berupa NAMA DOMAIN; 127.0.0.1 bukan nama domain,
# melainkan alamat. Peramban menolaknya sebelum satu pun permintaan dikirim,
# dengan SecurityError berbunyi "This is an invalid domain", dan rp_id
# "127.0.0.1" pun ditolak sama persis. Jadi tidak ada nilai mana pun yang
# membuat 127.0.0.1 bekerja. Bukalah http://localhost:8000/admin. Mesinnya
# sama, cuma namanya yang berbeda, dan cuma nama yang diterima WebAuthn.
#
# WEBAUTHN_ASAL adalah daftar asal lengkap yang boleh, ditulis sebagai JSON.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAMA=Hendro Kuswantoro
WEBAUTHN_ASAL=["http://localhost:8000"]

# --- cadangan ----------------------------------------------------------------
# Kunci AES-256 untuk mengunci berkas cadangan, ditulis base64. Buat dengan:
#   python backend/db/enkripsi.py kunci
#
# Kosongkan dan cadangannya tetap dibuat, hanya tanpa enkripsi, dan
# perintahnya akan mengatakan begitu. Wajib diisi sebelum cadangan dikirim
# keluar dari mesin ini; skrip pengirimnya menolak berkas yang tidak
# terenkripsi.
#
# Simpan salinan kuncinya di tempat yang BUKAN mesin ini. Kunci yang hilang
# berarti seluruh cadangan yang sudah terenkripsi tidak akan pernah terbuka.
CADANGAN_KUNCI=

# --- penyandian kolom --------------------------------------------------------
# Kunci AES-256 untuk menyandikan rahasia TOTP sebelum ia masuk basis data.
# Bentuknya sama dengan CADANGAN_KUNCI dan dibuat dengan perintah yang sama:
#   python backend/db/enkripsi.py kunci
#
# Sengaja BERBEDA dari CADANGAN_KUNCI. Cadangan dan kolom basis data tidak
# seharusnya bisa dibuka oleh satu kunci yang sama: yang memegang cadangan
# belum tentu berhak membuka rahasia yang masih hidup di basis data.
#
# Kosongkan dan aplikasi authenticator tidak bisa dipasang sama sekali, dan
# halaman keamanannya akan mengatakan begitu. Ia TIDAK akan menyimpan
# rahasianya apa adanya sebagai gantinya: faktor kedua yang ikut bocor bersama
# hash sandinya bukan faktor kedua.
KUNCI_KOLOM=

# --- surat -------------------------------------------------------------------
# Dipakai verifikasi alamat email dan kode masuk enam angka.
#
# Kosongkan dan suratnya TIDAK dikirim. Ia ditulis ke cadangan/surat/ sebagai
# berkas .eml, dan setiap layar yang memintanya akan mengatakan bahwa suratnya
# tidak berangkat. Yang tidak akan pernah terjadi: aplikasi ini membalas
# "kode sudah dikirim" untuk surat yang tidak pernah ada. Verifikasi email
# yang emailnya tidak pernah sampai bukan verifikasi apa apa.
#
# SURAT_WAJIB=1 membuatnya melempar galat alih alih menulis berkas. Pasang itu
# di produksi: di sana, surat yang diam diam mendarat di folder adalah surat
# yang hilang.
SMTP_HOST=
SMTP_PORTA=587
SMTP_PENGGUNA=
SMTP_SANDI=
SURAT_DARI=
SURAT_WAJIB=

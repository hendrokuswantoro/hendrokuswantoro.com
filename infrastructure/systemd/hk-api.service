[Unit]
Description=hendrokuswantoro.com API
Documentation=https://github.com/hendrokuswantoro/personal-web
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=hk
Group=hk
WorkingDirectory=/srv/hendrokuswantoro/app

EnvironmentFile=/etc/hendrokuswantoro/env

ExecStart=/srv/hendrokuswantoro/venv/bin/python -m uvicorn backend.main:aplikasi \
    --uds /run/hk-api/api.sock \
    --workers 2 \
    --proxy-headers \
    --forwarded-allow-ips='*' \
    --no-access-log

ExecStartPost=/bin/sh -c 'until [ -S /run/hk-api/api.sock ]; do sleep 0.1; done; chmod 660 /run/hk-api/api.sock'

ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3s

RuntimeDirectory=hk-api
RuntimeDirectoryMode=0750

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
UMask=0027

MemoryMax=512M
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
